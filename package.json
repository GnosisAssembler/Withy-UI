{
  "name": "sprig",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter sprig-design-system build && pnpm --parallel --filter sprig-design-system --filter docs dev",
    "build": "pnpm --filter sprig-design-system build && pnpm --filter docs build",
    "start": "pnpm --filter docs start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter sprig-design-system test",
    "test:watch": "pnpm --filter sprig-design-system test:watch",
    "typecheck": "pnpm --filter sprig-design-system typecheck && pnpm --filter sprig-design-system build && pnpm --filter docs typecheck",
    "commit": "cz",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm --filter sprig-design-system build && pnpm changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,css,md,json}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "16.3.8",
    "prettier": "^3.9.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.15.0"
}
